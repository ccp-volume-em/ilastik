ARG UBUNTU_VERSION=24.04
ARG ILASTIK_VERSION=1.4.2
ARG VGL_VERSION=3.1.4

FROM ubuntu:${UBUNTU_VERSION} AS download
ARG ILASTIK_VERSION
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        wget bzip2 ca-certificates \
    && wget -q -P /tmp https://files.ilastik.org/ilastik-${ILASTIK_VERSION}-gpu-Linux.tar.bz2 \
    && tar -xjf /tmp/ilastik-${ILASTIK_VERSION}-gpu-Linux.tar.bz2 -C /opt \
    && mv /opt/ilastik-* /opt/ilastik \
    && rm -rf /tmp/*.tar.bz2 /var/lib/apt/lists/*

# run_ilastik.sh clears LD_LIBRARY_PATH; preserve it via LD_LIBRARY_PATH_NV
RUN sed -i 's/^export LD_LIBRARY_PATH=""$/export LD_LIBRARY_PATH="${LD_LIBRARY_PATH_NV:-}"/' /opt/ilastik/run_ilastik.sh \
    && grep -q 'LD_LIBRARY_PATH_NV' /opt/ilastik/run_ilastik.sh

FROM ubuntu:${UBUNTU_VERSION} AS gpu
ARG UBUNTU_VERSION
ARG ILASTIK_VERSION
ARG DEBIAN_FRONTEND=noninteractive
ARG IMAGE_VERSION="${ILASTIK_VERSION}"
ARG IMAGE_REVISION=""
ARG IMAGE_CREATED=""

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglu1-mesa \
        libxcb-cursor0 libxkbcommon-x11-0 libxrender1 libxi6 libfontconfig1 \
        libdbus-1-3 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=download /opt/ilastik /opt/ilastik

RUN printf '#!/bin/sh\nexport LD_LIBRARY_PATH_NV="$LD_LIBRARY_PATH"\nexec /opt/ilastik/run_ilastik.sh "$@"\n' \
        > /usr/local/bin/ilastik-entrypoint \
    && chmod +x /usr/local/bin/ilastik-entrypoint

ENV NUMBA_CACHE_DIR=/tmp/numba_cache \
    BIOIMAGEIO_CACHE_PATH=/tmp/pybio_cache

LABEL org.opencontainers.image.title="RFI/CCP-volumeEM ilastik (GPU)" \
      org.opencontainers.image.description="Ubuntu container with GPU-enabled ilastik" \
      org.opencontainers.image.authors="The Rosalind Franklin Institute, The Collaborative Computational Project for Volume Electron Microscopy" \
      org.opencontainers.image.source="https://github.com/ccp-volume-em/ilastik" \
      org.opencontainers.image.documentation="https://rosalindfranklininstitute.github.io/volume-em-container-documentation/software/ilastik/" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.base.name="docker.io/library/ubuntu:${UBUNTU_VERSION}" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.created="${IMAGE_CREATED}" \
      uk.ac.rfi.ilastik.source="https://github.com/ilastik/ilastik"

ENTRYPOINT ["/usr/local/bin/ilastik-entrypoint"]

FROM gpu AS vgl
ARG VGL_VERSION
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates \
    && wget -q -P /tmp https://github.com/VirtualGL/virtualgl/releases/download/${VGL_VERSION}/virtualgl_${VGL_VERSION}_amd64.deb \
    && apt-get install -y --no-install-recommends /tmp/virtualgl_${VGL_VERSION}_amd64.deb \
    && rm -f /tmp/virtualgl_*.deb \
    && apt-get purge -y wget && apt-get autoremove -y \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN printf '#!/bin/sh\nexport LD_LIBRARY_PATH_NV="$LD_LIBRARY_PATH"\nexec vglrun /opt/ilastik/run_ilastik.sh "$@"\n' \
        > /usr/local/bin/ilastik-entrypoint-vgl \
    && chmod +x /usr/local/bin/ilastik-entrypoint-vgl

LABEL org.opencontainers.image.title="RFI/CCP-volumeEM ilastik (GPU + VirtualGL)" \
      org.opencontainers.image.description="Ubuntu container with GPU-enabled ilastik and VirtualGL" \
      uk.ac.rfi.virtualgl.version="${VGL_VERSION}"

ENTRYPOINT ["/usr/local/bin/ilastik-entrypoint-vgl"]
